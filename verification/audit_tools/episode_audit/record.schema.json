{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Episode Audit v1 JSONL record",
  "$comment": "Python additionally enforces finite metrics, exact integer types, no control/edge whitespace in identifiers, paired null seeds, ordering, and cross-record constraints.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "episode_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "episode"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "seed_namespace": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "episode_idx",
        "type",
        "split",
        "seed_namespace",
        "seed",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "episode_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "evaluation"
        },
        "start_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "goal_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluation_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidate_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "metric": {
          "type": "number"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "source_id",
        "episode_idx",
        "type",
        "start_step",
        "goal_step",
        "evaluation_seed",
        "method",
        "candidate_budget",
        "metric",
        "conditions"
      ],
      "additionalProperties": false
    }
  ]
}
